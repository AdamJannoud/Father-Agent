# Father Agent configuration. Copy to .env and fill in what you have:
#     cp .env.example .env
# .env is git-ignored. Never commit a real key.
#
# With NO keys at all the factory still works, using an offline mock provider
# (deterministic templates, no network). Add at least one free key for real
# model-written sub-agents.

# --- Groq free tier ---------------------------------------------------------
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Default qwen/qwen3.8-27b; alternatives: openai/gpt-oss-120b (an open-weight model
# served by Groq, not the OpenAI API). See https://console.groq.com/docs/models
# GROQ_MODEL=qwen/qwen3.8-27b

# --- Hugging Face Serverless Inference ---------------------------------------
# Free token ("Read" or "Inference" scope): https://huggingface.co/settings/tokens
HF_TOKEN=
# HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# --- Google Gemini API free tier -----------------------------------------------
# Free key: https://aistudio.google.com/apikey (GOOGLE_API_KEY is read if
# GEMINI_API_KEY is empty). Called via Gemini's OpenAI-compatible endpoint.
# Use a key from a project WITHOUT billing enabled to stay on the free tier.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- Behaviour (all optional) -------------------------------------------------
# Order in which keyed providers are tried; a 429 or retired model falls through.
# FATHER_PROVIDER_ORDER=groq,huggingface,gemini
# Append the offline mock after the real providers if they all fail.
# FATHER_ALLOW_MOCK_FALLBACK=false
# FATHER_REQUEST_TIMEOUT=90
# FATHER_MAX_RETRIES=3
# FATHER_MAX_CONCURRENCY=2
# FATHER_MAX_REPAIR_ATTEMPTS=2
# FATHER_TEMPERATURE=0.2
# FATHER_OUTPUT_DIR=subagents
# FATHER_LOG_DIR=logs
# FATHER_LOG_LEVEL=INFO

# --- Local model (off by default) ---------------------------------------------
# A llama.cpp server (or any OpenAI-compatible server) on THIS machine only.
# Example: ./llama-server -m qwen2.5-coder-1.5b-instruct-q4_k_m.gguf --port 8080
# FATHER_LOCAL_LLM_URL=http://127.0.0.1:8080/v1
# FATHER_LOCAL_LLM_MODEL=local
# then add "local" to FATHER_PROVIDER_ORDER, e.g. groq,huggingface,local

# --- Telegram bot (optional extra: pip install -r requirements-bot.txt) -------
# python main.py bot. Token from @BotFather (/newbot).
# TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to use the bot. EMPTY REFUSES
# EVERYONE: message the bot once, it replies with your id, paste it here.
# TELEGRAM_ALLOWED_USERS=
# Health endpoint port (/healthz); hosts like Render and Koyeb set PORT.
# PORT=8080
# Webhook mode is off by default (polling). Set both to switch it on.
# TELEGRAM_WEBHOOK_URL=https://your-service.example.com
# TELEGRAM_WEBHOOK_SECRET=
